{
  "name": "Blast",
  "scopeName": "source.blast",
  "patterns": [
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#function-decl" },
    { "include": "#type-annotation" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.blast",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.blast", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.blast", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.blast", "match": "\\b[0-9]+\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.boolean.blast",
      "match": "\\b(true|false)\\b"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.blast", "match": "\\b(if|else|while|for|return|break|continue)\\b" },
        { "name": "keyword.declaration.blast", "match": "\\b(func|module)\\b" }
      ]
    },
    "function-decl": {
      "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.blast" },
        "2": { "name": "entity.name.function.blast" }
      }
    },
    "type-annotation": {
      "match": "(::)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.type.blast" },
        "2": { "name": "entity.name.type.blast" }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.blast" } }
    },
    "operators": {
      "name": "keyword.operator.blast",
      "match": "==|!=|<=|>=|[+*<>=]"
    }
  }
}
